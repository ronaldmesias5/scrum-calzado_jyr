# ========================
# CALZADO J&R — Git Ignore
# ========================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
*.egg-info/
dist/
build/
.eggs/

# Environment (cubre .env.production, .env.development, .env.test, .env.docker…)
.env
*.env.local
.env.*
!.env.example

# Secrets / credenciales (claves TLS, tokens de registry)
*.pem
*.key
*.p12
*.pfx
*.jks
*.crt
*.csr
.npmrc
.netrc

# IDE / config local de agentes (no versionar)
.vscode/
.claude/
.idea/
*.swp
*.swo

# Node
node_modules/
dist/
*.tsbuildinfo

# OS
.DS_Store
Thumbs.db
desktop.ini
*.lnk

# Agent/Editor config (opencode)
.agents/
.config/
.opencode/
opencode.json
skills-lock.json

# Testing / linting / coverage
.coverage
htmlcov/
coverage/
*.lcov
coverage.xml
.pytest_cache/
.ruff_cache/

# Docker
docker-compose.override.yml

# Uploads (archivos de usuario, no del código)
uploads/
be/uploads/

# Database dumps / backups / ficheros locales
*.dump
*.bak
*.orig
*.old
*.sqlite
*.sqlite3
*.db

# Postman (credenciales locales)
test/back/*.postman_environment/
*.postman_environment.json
*.postman_environment/

# test/ se SUBE a git (scripts Selenium, SQL y guías son útiles para el equipo)
!test/

# Checklists / documentos locales del SENA
Lista de Chequeo*

# Project specific

be/logs/
be/tmp_*.py
be/sql_check.py
*.log

# Temp curl cookies (Fase 3 testing)
cookies.txt
