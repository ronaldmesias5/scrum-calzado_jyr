# ========================
# CALZADO J&R — Git Ignore
# ========================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
*.egg-info/
dist/
build/
.eggs/

# Environment
.env
*.env.local

# IDE
.vscode/settings.json
.vscode/*.code-workspace
.idea/
*.swp
*.swo

# Node
node_modules/
dist/
*.tsbuildinfo

# OS
.DS_Store
Thumbs.db

# Agent/Editor config (opencode)
.agents/
.config/
.opencode/
opencode.json
skills-lock.json

# Testing
.coverage
htmlcov/
.pytest_cache/

# Docker
docker-compose.override.yml

# Uploads (archivos de usuario, no del código)
uploads/
be/uploads/

# Database dumps / backups
*.dump
*.bak

# Postman environments (credenciales locales)
test/back/*.postman_environment/

# test/ se SUBE a git (scripts Selenium, SQL y guías son útiles para el equipo)
!test/

# Checklists / documentos locales del SENA
Lista de Chequeo*

# Project specific

be/logs/
be/tmp_*.py
be/sql_check.py
*.log
