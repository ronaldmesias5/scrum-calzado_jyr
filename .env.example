# ============================================================
# CALZADO J&R — Variables de Entorno (ÚNICO .env.example)
# ============================================================
# Este es el ÚNICO archivo .env.example del proyecto.
# Los archivos be/.env.example y fe/.env.example están OBSOLETOS.
#
# INSTRUCCIONES:
#   cp .env.example .env
#   Editar .env con valores reales para tu entorno.
#   NUNCA versionar .env en git.
# ============================================================

# ════════════════════════════════════════
# 🐘 PostgreSQL — Base de datos
# ════════════════════════════════════════
# Para Docker:     host=db
# Para local:      host=localhost
DATABASE_URL=postgresql://jyr_user:jyr_password@db:5432/calzado_jyr_db
POSTGRES_USER=jyr_user
POSTGRES_PASSWORD=jyr_password
POSTGRES_DB=calzado_jyr_db
DB_PORT=5432

# ════════════════════════════════════════
# 🔐 JWT y Seguridad
# ════════════════════════════════════════
# Generar SECRET_KEY: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace_with_a_secure_random_secret_for_dev_only
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ════════════════════════════════════════
# 📧 Email — Recuperación de contraseña
# ════════════════════════════════════════
MAIL_SERVER=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=notificaciones@calzadojyr.com
MAIL_FROM_NAME=Calzado J&R

# ════════════════════════════════════════
# 🌐 URLs de servicios
# ════════════════════════════════════════
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:8000

# ════════════════════════════════════════
# 🔌 Puertos expuestos al host
# ════════════════════════════════════════
BE_PORT=8000
FE_PORT=5173

# ════════════════════════════════════════
# 🏢 Ambiente (development | production)
# ════════════════════════════════════════
ENVIRONMENT=development
